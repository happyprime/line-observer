{
  "name": "@happyprime/line-observer",
  "version": "0.0.1",
  "description": "A performant scroll interaction observer that triggers handlers when elements cross a configurable trigger line in the viewport",
  "type": "module",
  "module": "line-observer.js",
  "unpkg": "build/line-observer.js",
  "jsdelivr": "build/line-observer.js",
  "exports": {
    ".": {
      "import": "./line-observer.js",
      "default": "./line-observer.js"
    },
    "./build/*": "./build/*",
    "./package.json": "./package.json"
  },
  "files": [
    "line-observer.js",
    "build/"
  ],
  "scripts": {
    "lint": "eslint ./",
    "fix": "eslint ./ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "rollup -c",
    "prepare": "rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happyprime/line-observer.git"
  },
  "keywords": [
    "scroll",
    "observer",
    "animation",
    "intersection",
    "trigger",
    "viewport",
    "scroll-driven"
  ],
  "author": "Happy Prime",
  "license": "MIT",
  "devDependencies": {
    "@happyprime/eslint-config": "^1.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "rollup": "^4.64.12",
    "terser": "^5.51.2",
    "vitest": "^5.0.5"
  },
  "bugs": {
    "url": "https://github.com/happyprime/line-observer/issues"
  },
  "homepage": "https://github.com/happyprime/line-observer#readme"
}
